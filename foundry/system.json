{
  "id": "kindlewild",
  "title": "Kindlewild",
  "description": "Children's creature RPG: card-style sheet, moves and XP track. Creatures come from scenario modules.",
  "version": "0.3.0",
  "compatibility": { "minimum": "14.364", "verified": "14.365", "maximum": "14" },
  "authors": [{ "name": "Alan Leite" }],
  "esmodules": ["kindlewild.mjs"],
  "styles": ["styles/kindlewild.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "pt-BR", "name": "Português (Brasil)", "path": "lang/pt-BR.json" }
