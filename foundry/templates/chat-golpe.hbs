<div class="kindlewild-chat">
  <h3>{{atacante}}: {{golpe}}</h3>
  <div class="linha"><span>{{sys.elemento}}</span>{{#if sys.area}}<span>{{localize "KINDLEWILD.Chat.Area"}}</span>{{/if}}</div>
  {{#if formula}}
  <div class="linha"><strong>{{localize "KINDLEWILD.Chat.Acerto"}}: {{acerto}}</strong><span>{{localize "KINDLEWILD.Chat.AcertaSe"}}</span></div>
  <div class="linha"><strong>{{localize "KINDLEWILD.Chat.Dano"}}: {{dano}}</strong><span>{{formula}}</span></div>
  {{/if}}
  {{#if sys.efeito}}<div class="linha"><span>{{localize "KINDLEWILD.Chat.Efeito"}}</span><strong>{{sys.efeito}}</strong></div>{{/if}}
  <div class="referencia">
    {{localize "KINDLEWILD.Chat.Alvo"}}: {{#if alvo}}{{alvo}}{{else}}—{{/if}} ·
    {{localize "KINDLEWILD.Chat.Agilidade"}} {{ref.agilidade}} ·
    {{localize "KINDLEWILD.Chat.Defesa"}} {{ref.defesa}} ·
    {{localize "KINDLEWILD.Chat.Resistencia"}} {{ref.resistencia}}
  </div>
</div>
