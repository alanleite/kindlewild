<section class="tab trilho {{tab.cssClass}}" data-tab="trilho" data-group="primary">
  <div class="kw-carta" style="--cor-tipo: {{corTipo}}">
    <header class="kw-topo"><span class="kw-numero">#{{numero}}</span><h1 class="kw-nome">{{actor.name}}</h1><span class="kw-progresso">{{system.trilho.progresso}} / 70</span></header>
    <div class="kw-trilho">
      {{#each trilho}}
      <button type="button" class="kw-casa {{#if riscado}}riscada{{/if}} {{#if tipo}}marca marca-{{tipo}}{{/if}}" data-action="progresso" data-pos="{{pos}}" data-tooltip="{{pos}}">
        {{#if icone}}<span class="kw-icone">{{icone}}</span>{{else}}<span class="kw-pos">{{pos}}</span>{{/if}}
      </button>
      {{/each}}
    </div>
  </div>
</section>
