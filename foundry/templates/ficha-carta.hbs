<section class="tab carta {{tab.cssClass}}" data-tab="carta" data-group="primary">
  <div class="kw-carta" style="--cor-tipo: {{corTipo}}">
    <header class="kw-topo">
      <span class="kw-numero">#{{numero}}</span>
      <h1 class="kw-nome">{{actor.name}}</h1>
      <span class="kw-tipos">{{#each tipos}}<span class="kw-tipo" style="--cor: {{cor}}">{{nome}}</span>{{/each}}</span>
    </header>
    <figure class="kw-arte"><img src="{{actor.img}}" alt="{{actor.name}}"></figure>

    <div class="kw-bloco">
      <div class="kw-coracoes">
        {{#each coracoes}}<button type="button" class="kw-coracao {{#if cheio}}cheio{{/if}}" data-action="coracao" data-indice="{{indice}}" aria-label="coração {{indice}}">♥</button>{{/each}}
      </div>
      <div class="kw-acoes">
        <button type="button" data-action="centro">🏥 {{localize "KINDLEWILD.Botao.Centro"}}</button>
        <button type="button" data-action="descanso">🌙 {{localize "KINDLEWILD.Botao.Descanso"}}</button>
      </div>
    </div>

    <div class="kw-atributos">
      {{#each atributos}}
      <div class="kw-atributo">
        <span class="kw-rotulo">{{rotulo}}</span>
        <span class="kw-caixas">{{#each caixas}}<button type="button" class="kw-caixa {{#if cheia}}cheia{{/if}}" data-action="estrela" data-atributo="{{../chave}}" data-indice="{{indice}}" aria-label="estrela {{indice}}"></button>{{/each}}</span>
      </div>
      {{/each}}
    </div>

    <ol class="kw-golpes">
      {{#each golpes}}
      <li class="kw-golpe {{#unless liberado}}bloqueado{{/unless}}" style="--cor: {{corElemento}}">
        <button type="button" class="kw-liberar {{#if liberado}}marcado{{/if}}" data-action="liberar" data-item-id="{{id}}" aria-label="liberar golpe">{{#if liberado}}✓{{/if}}</button>
        <button type="button" class="kw-rolar" data-action="rolar" data-item-id="{{id}}" {{#unless liberado}}disabled{{/unless}}>
          <span class="kw-golpe-nome">{{nome}}</span>
          {{#if efeito}}<span class="kw-efeito">{{efeito}}</span>{{/if}}
          {{#if sys.area}}<span class="kw-efeito">Área</span>{{/if}}
          {{#if sys.dado}}<span class="kw-dado">{{sys.dado}}<small>+ {{atributo}}</small></span>{{else}}<span class="kw-dado suporte">suporte</span>{{/if}}
          {{#if bolinhas.length}}<span class="kw-bolinhas">{{#each bolinhas}}<i class="{{#if cheia}}cheia{{/if}}"></i>{{/each}}</span>{{/if}}
        </button>
      </li>
      {{/each}}
    </ol>

    {{#if resistencias.length}}
    <div class="kw-resist">
      {{#each resistencias}}<span class="kw-chip {{efeito}}" style="--cor: {{cor}}">{{nome}} <b>{{marca}}</b></span>{{/each}}
    </div>
    {{/if}}
  </div>
</section>
